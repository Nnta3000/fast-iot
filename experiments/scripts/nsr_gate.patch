+def _dump_nicp_cost(path, sq, argmin_i, points, idx, *, iteration):
+    """IOT-GATE: write NICP's cost matrix and the sampled points' vertex ids.
+
+    `sq` is (1, M, K): squared offset norms for template vertex i at query point k. Saved transposed as
+    `cost` (K, M) so a row is one target point, matching the decoder's convention.
+    """
+    import os
+    folder = os.path.dirname(str(path))
+    if folder:
+        os.makedirs(folder, exist_ok=True)
+    cost = sq[0].transpose(0, 1).detach().cpu().numpy().astype(np.float32)
+    np.savez_compressed(
+        str(path),
+        cost=cost,
+        nicp_assignment=argmin_i[0].detach().cpu().numpy().astype(np.int64),
+        target_points=points[0].detach().cpu().numpy().astype(np.float32),
+        template_vertex_id=idx.detach().cpu().numpy().astype(np.int64),
+        iteration=np.int64(iteration),
+    )
